{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "cwd": "${workspaceFolder}",
      "name": "Backend (Go)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/backend"
    },
    {
      "name": "Frontend (Next.js)",
      "type": "node-terminal",
      "request": "launch",
      "cwd": "${workspaceFolder}/web",
      "command": "cd '${workspaceFolder}/web' && pnpm dev"
    },
    {
      "name": "Frontend: debug client-side",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000"
    },
    {
      "cwd": "${workspaceFolder}",
      "name": "Launch Configen",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/internal/tools/configen",
      "args": []
    }
  ],
  "compounds": [
    {
      "name": "🚀 Storyden: Backend + Frontend",
      "configurations": [
        "Backend (Go)",
        "Frontend (Next.js)"
      ],
      "stopAll": true
    }
  ]
}