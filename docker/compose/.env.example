# ============================================================
#  Storyden – lokale Umgebungsvariablen für Docker Compose
# ============================================================
#
# Kopiere diese Datei nach .env und fülle deine Werte ein.
# Die .env-Datei ist gitignored und wird NICHT ins Repo eingecheckt!
#
# Felder mit einem Wert sind Beispiele/Defaults.
# Felder ohne Wert (leer) müssen ausgefüllt werden, wenn der
# zugehörige Dienst aktiviert wird.
#
# ============================================================

# ----------------------------------------------------------
# Adressen (Pflicht)
# ----------------------------------------------------------
PUBLIC_WEB_ADDRESS=http://localhost:3000
PUBLIC_API_ADDRESS=http://localhost:8000

# ----------------------------------------------------------
# Datenbank (PostgreSQL)
#
# POSTGRES_* konfigurieren den postgres-Container, DATABASE_URL sagt der App,
# wohin sie verbinden soll. Beide müssen zusammenpassen.
#
# Host "postgres" ist der Compose-Servicename – so erreicht die App die DB.
# Vom Host aus (cmd/migrate, cmd/sqlite2postgres) stattdessen localhost:5432.
#
# Passwort erzeugen: openssl rand -hex 24
# ----------------------------------------------------------
POSTGRES_USER=storyden
POSTGRES_PASSWORD=dein-sicheres-datenbank-passwort
POSTGRES_DB=storyden

DATABASE_URL=postgresql://storyden:dein-sicheres-datenbank-passwort@postgres:5432/storyden?sslmode=disable

# Zurück auf SQLite (Rollback): DATABASE_URL auskommentieren, dann greift der
# eingebaute Default sqlite://data/data.db?_pragma=foreign_keys(1)

# ----------------------------------------------------------
# JWT Secret (Pflicht für E-Mail-Auth und OAuth)
# Neuen Wert erzeugen: openssl rand -hex 32
# NICHT ändern, sobald Nutzer registriert sind!
# ----------------------------------------------------------
JWT_SECRET=dein-sicherer-jwt-secret

# ----------------------------------------------------------
# E-Mail (SMTP) – Pflicht wenn EMAIL_PROVIDER=smtp
# ----------------------------------------------------------
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=dein-benutzername@smtp-brevo.com
SMTP_PASSWORD=dein-smtp-passwort
SMTP_FROM_ADDRESS=deine-email@beispiel.com
SMTP_FROM_NAME=Dein-Forum-Name
SMTP_USE_TLS=true

# Alternativ: SendGrid
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=
# SENDGRID_FROM_ADDRESS=
# SENDGRID_FROM_NAME=

# ----------------------------------------------------------
# OAuth / SSO (optional)
# ----------------------------------------------------------
# OAUTH_GOOGLE_ENABLED=false
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=

# OAUTH_GITHUB_ENABLED=false
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# OAUTH_DISCORD_ENABLED=false
# OAUTH_DISCORD_CLIENT_ID=
# OAUTH_DISCORD_CLIENT_SECRET=

# OAUTH_KEYCLOAK_ENABLED=false
# OAUTH_KEYCLOAK_CLIENT_ID=
# OAUTH_KEYCLOAK_CLIENT_SECRET=
# OAUTH_KEYCLOAK_ISSUER_URL=

# ----------------------------------------------------------
# Datei-/Asset-Speicher (optional – Standard ist lokal)
# ----------------------------------------------------------
# ASSET_STORAGE_TYPE=local
# ASSET_STORAGE_LOCAL_PATH=data/assets

# S3-kompatibler Speicher (AWS S3, Cloudflare R2, Minio …)
# ASSET_STORAGE_TYPE=s3
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_SECURE=true

# ----------------------------------------------------------
# Cache (optional – Standard ist In-Memory)
# ----------------------------------------------------------
# CACHE_PROVIDER=redis
# REDIS_URL=redis://localhost:6379

# ----------------------------------------------------------
# Suche (optional – Standard ist Datenbank-Suche)
# ----------------------------------------------------------
# SEARCH_PROVIDER=bleve

# ----------------------------------------------------------
# SMS / Twilio (optional)
# ----------------------------------------------------------
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ----------------------------------------------------------
# KI / OpenAI (optional)
# ----------------------------------------------------------
# LANGUAGE_MODEL_PROVIDER=openai
# OPENAI_API_KEY=
# MCP_ENABLED=false

# ----------------------------------------------------------
# Sentry / Monitoring (optional)
# ----------------------------------------------------------
# OTEL_PROVIDER=sentry
# SENTRY_DSN=

# ----------------------------------------------------------
# Logging (optional)
# ----------------------------------------------------------
# LOG_LEVEL=info
# LOG_FORMAT=dev
