# Kopiere diese Datei nach .env und fülle deine eigenen Werte ein.
# Die .env-Datei wird NICHT ins Git-Repository eingecheckt.

PUBLIC_WEB_ADDRESS=http://localhost:3000
PUBLIC_API_ADDRESS=http://localhost:8000

# SMTP-Konfiguration (z.B. Brevo/Sendinblue)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=dein-smtp-benutzername@smtp-brevo.com
SMTP_PASSWORD=dein-smtp-passwort
SMTP_FROM_ADDRESS=deine-email@beispiel.com
SMTP_FROM_NAME=Dein-Forum-Name
SMTP_USE_TLS=true

# JWT Secret - geheim halten und NICHT ändern sobald Nutzer registriert sind!
JWT_SECRET=dein-sicherer-jwt-secret
