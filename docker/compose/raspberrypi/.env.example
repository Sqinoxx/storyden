# ============================================================
#  Storyden - Raspberry Pi, HTTPS auf Port 8443
# ============================================================
#
# Diese Datei liegt auf dem PI neben der docker-compose.yml.
#
# export-data.ps1 auf dem Windows-PC erzeugt eine vorgefuellte Version dieser
# Datei unter transfer/.env - mit JWT_SECRET, Brevo-Zugangsdaten und
# Datenbank-Passwort aus dem bestehenden Setup. Dort muessen dann nur noch die
# Domain-Zeilen angepasst werden.
#
# Auf dem Pi:  chmod 600 .env
#
# ============================================================

# ----------------------------------------------------------
# Image
#
# Wird auf dem PC gebaut und per docker load eingespielt, nicht aus einer
# Registry geholt. build-image.ps1 vergibt zusaetzlich einen Datums-Tag
# (z.B. storyden-rpi:2026-08-10), mit dem man jederzeit zurueckrollen kann.
# ----------------------------------------------------------
STORYDEN_IMAGE=storyden-rpi:latest

# ----------------------------------------------------------
# Domain und HTTPS (Pflicht)
#
# SITE_DOMAIN wird von Caddy fuer das Let's-Encrypt-Zertifikat genutzt,
# ACME_EMAIL bekommt Ablaufwarnungen von Let's Encrypt.
#
# Voraussetzung: A-Record der Domain zeigt auf die aktuelle oeffentliche IP
# des Anschlusses (dafuer sorgt der ddns-Service) und der Router leitet
# extern 443 auf Pi:8443 weiter.
# ----------------------------------------------------------
SITE_DOMAIN=unidentists.social
ACME_EMAIL=

# Die URL, die im Browser aufgerufen wird - ohne Slash am Ende. Steuert
# Session-Cookies, CORS, Passkeys und die Links in den Bestaetigungsmails.
# Muss exakt stimmen.
#
# Variante A (Standard): Router leitet extern 443 -> Pi 8443, saubere URL.
PUBLIC_WEB_ADDRESS=https://unidentists.social
PUBLIC_API_ADDRESS=https://unidentists.social
#
# Variante B: kein 443 im Router, nur Port 80 freigegeben - dann muss der
# Port in der URL stehen und im docker-compose.yml die 443er-Zeile beim
# caddy-Service raus.
# PUBLIC_WEB_ADDRESS=https://unidentists.social:8443
# PUBLIC_API_ADDRESS=https://unidentists.social:8443
#
# Ein Wechsel zwischen A und B loggt alle Nutzer aus und macht registrierte
# Passkeys ungueltig, weil sich die Origin aendert.

# ----------------------------------------------------------
# DynDNS (Service "ddns")
#
# Aktualisiert den A-Record bei name.com. Zugangsdaten stehen nicht hier,
# sondern in ddns/config.json (siehe ddns-config.example.json).
# ----------------------------------------------------------
DDNS_PERIOD=5m
TZ=Europe/Berlin

# ----------------------------------------------------------
# Datenbank (PostgreSQL)
#
# Host "postgres" ist der Compose-Servicename. Vom Pi-Host aus (Backups,
# Restore) laeuft die Verbindung ueber localhost:5432.
#
# Passwort erzeugen: openssl rand -hex 24
# ----------------------------------------------------------
POSTGRES_USER=storyden
POSTGRES_PASSWORD=
POSTGRES_DB=storyden

DATABASE_URL=postgresql://storyden:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/storyden?sslmode=disable

# ----------------------------------------------------------
# JWT Secret (Pflicht)
#
# UNBEDINGT den Wert aus dem alten Setup (docker/compose/.env) uebernehmen.
# Ein neuer Wert entwertet alle bestehenden Sessions und offenen
# Passwort-Reset-Links.
# ----------------------------------------------------------
JWT_SECRET=

# ----------------------------------------------------------
# E-Mail (Brevo ueber SMTP)
#
# Unveraendert aus dem bestehenden Setup uebernehmen.
# SMTP_FROM_ADDRESS muss zu einer bei Brevo verifizierten Domain gehoeren
# (SPF/DKIM), sonst landen die Mails im Spam.
# ----------------------------------------------------------
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=mail@unidentists.social
SMTP_FROM_NAME=Unidentists
SMTP_USE_TLS=true

# ----------------------------------------------------------
# Uploads
# Groesster akzeptierter Request-Body in MB, muss <= max_size im Caddyfile
# (64MB) bleiben.
# ----------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50

# ----------------------------------------------------------
# OCR (Texterkennung in Bildern und PDFs)
#
# Laeuft auf dem Pi, ist aber CPU-hungrig. Der Backfill bleibt aus, sonst
# arbeitet der Pi nach jedem Neustart alle Altbestaende erneut ab.
# ----------------------------------------------------------
OCR_ENABLED=true
OCR_PROVIDER=tesseract
OCR_LANGUAGES=deu,eng
OCR_MAX_FILE_SIZE_MB=10
OCR_PDF_MAX_PAGES=20
OCR_BACKFILL_ENABLED=false

# ----------------------------------------------------------
# Google Drive Bibliothek (optional)
#
# Auch komplett ueber die Admin-Oberflaeche konfigurierbar. Wenn hier gesetzt:
# Service-Account-JSON in einer Zeile oder base64.
# ----------------------------------------------------------
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_CACHE_TTL=1m

# ----------------------------------------------------------
# Rate Limiting (pro Zeitfenster und IP/Account)
# ----------------------------------------------------------
RATE_LIMIT=5000
RATE_LIMIT_PERIOD=1h

# ----------------------------------------------------------
# Logging
# ----------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
