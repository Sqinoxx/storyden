# ============================================================
#  Storyden - Ubuntu-Server (192.168.178.105), unidentists.social
# ============================================================
#
# Kopiere diese Datei nach .env und fuelle deine Werte ein.
# Die .env-Datei ist gitignored und wird NICHT ins Repo eingecheckt.
#
#   cp .env.example .env
#   chmod 600 .env
#
# ============================================================

# ----------------------------------------------------------
# Image
#
# Wird auf dem Windows-PC gebaut (build-image.ps1) und per docker load
# eingespielt, nicht aus einer Registry geholt. build-image.ps1 vergibt
# zusaetzlich einen Datums-Tag (z.B. storyden-server:2026-08-16), mit dem man
# jederzeit zurueckrollen kann.
# ----------------------------------------------------------
STORYDEN_IMAGE=storyden-server:latest

# ----------------------------------------------------------
# Domain und HTTPS (Pflicht)
#
# SITE_DOMAIN wird von Caddy fuer das Let's-Encrypt-Zertifikat genutzt,
# ACME_EMAIL bekommt Ablaufwarnungen von Let's Encrypt.
#
# Voraussetzung: der A-Record der Domain zeigt auf die oeffentliche IP des
# Anschlusses, und der Router leitet extern 80 und 443 auf den Server
# (192.168.178.105) weiter. Siehe Anleitung.md.
# ----------------------------------------------------------
SITE_DOMAIN=unidentists.social
ACME_EMAIL=

# Muessen exakt der Domain entsprechen, auf die der DNS zeigt - inklusive
# https:// und ohne abschliessenden Slash. Falsche Werte brechen Login,
# Cookies, E-Mail-Links und Passkeys.
PUBLIC_WEB_ADDRESS=https://unidentists.social
PUBLIC_API_ADDRESS=https://unidentists.social

# ----------------------------------------------------------
# DynDNS (Service "ddns", optional)
#
# Nur noetig, wenn sich die oeffentliche IP des Anschlusses aendert. Aktiviert
# wird der Service separat mit "docker compose --profile ddns up -d", siehe
# Anleitung.md. Zugangsdaten stehen nicht hier, sondern in ddns/config.json.
# ----------------------------------------------------------
DDNS_PERIOD=5m
TZ=Europe/Berlin

# ----------------------------------------------------------
# Datenbank (PostgreSQL) - Pflicht
#
# Host "postgres" ist der Compose-Servicename. Vom Server-Host aus (Backups)
# stattdessen localhost:5432 verwenden.
#
# Passwort erzeugen:  openssl rand -hex 24
# ----------------------------------------------------------
POSTGRES_USER=storyden
POSTGRES_PASSWORD=
POSTGRES_DB=storyden

DATABASE_URL=postgresql://storyden:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/storyden?sslmode=disable

# ----------------------------------------------------------
# JWT Secret - Pflicht fuer E-Mail-Auth und OAuth
#
# Erzeugen:  openssl rand -hex 32
# NICHT mehr aendern, sobald Nutzer registriert sind - sonst werden alle
# Sessions und offenen Passwort-Reset-Links ungueltig.
# ----------------------------------------------------------
JWT_SECRET=

# ----------------------------------------------------------
# E-Mail (SMTP) - Pflicht fuer Registrierung und Passwort-Reset
#
# SMTP_FROM_ADDRESS muss zu einer Domain gehoeren, die beim Provider
# verifiziert ist (SPF/DKIM), sonst landen die Mails im Spam.
# ----------------------------------------------------------
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@unidentists.social
SMTP_FROM_NAME=Unidentists
SMTP_USE_TLS=true

# ----------------------------------------------------------
# Uploads
#
# Groesster akzeptierter Request-Body in MB. Muss <= max_size im
# Caddyfile (64MB) bleiben.
# ----------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50

# ----------------------------------------------------------
# OCR (Texterkennung in Bildern und PDFs)
#
# tesseract und pdftoppm sind im Image installiert. Auf einer 1-2-vCPU-VM
# OCR_BACKFILL_ENABLED=false setzen, sonst laeuft nach jedem Neustart eine
# CPU-intensive Nachverarbeitung.
# ----------------------------------------------------------
OCR_ENABLED=true
OCR_PROVIDER=tesseract
OCR_LANGUAGES=deu,eng
OCR_MAX_FILE_SIZE_MB=10
OCR_PDF_MAX_PAGES=20
OCR_BACKFILL_ENABLED=true

# ----------------------------------------------------------
# Google Drive Bibliothek (optional)
#
# Kann auch komplett ueber die Admin-Oberflaeche konfiguriert werden.
# Wenn hier gesetzt: Service-Account-JSON in einer Zeile oder base64.
# ----------------------------------------------------------
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_CACHE_TTL=1m

# ----------------------------------------------------------
# Rate Limiting
# Einheiten pro Zeitfenster und IP/Account.
# ----------------------------------------------------------
RATE_LIMIT=5000
RATE_LIMIT_PERIOD=1h

# ----------------------------------------------------------
# Logging
# LOG_FORMAT: "json" fuer Server, "dev" fuer farbige Ausgabe beim Debuggen,
# leer fuer schlichten Text.
# ----------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
